<?xml version="1.0" encoding="utf-8" ?>
<!-- Path: Skyscreen.App/Pages/ModuleIndexPage.xaml -->

<ContentPage
    x:Class="Skyscreen.App.Pages.ModuleIndexPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Skyscreen">

    <Grid
        Padding="24"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="20">

        <Label
            Grid.Row="0"
            FontAttributes="Bold"
            FontSize="32"
            HorizontalOptions="Center"
            Text="SKYSCREEN" />

        <Border
            Grid.Row="1"
            Padding="16"
            StrokeThickness="1">

            <VerticalStackLayout Spacing="6">

                <Label
                    x:Name="ConnectionStatusLabel"
                    FontAttributes="Bold"
                    FontSize="16"
                    Text="Anslutningsstatus: Frånkopplad" />

                <Label
                    x:Name="ServerStatusLabel"
                    FontSize="14"
                    Text="Serverstatus: Ingen status mottagen" />

                <Label
                    x:Name="DcsStatusLabel"
                    FontSize="14"
                    Text="DCS-status: Okänd" />

            </VerticalStackLayout>

        </Border>

        <Label
            Grid.Row="2"
            FontSize="18"
            HorizontalOptions="Center"
            Text="Välj DCS-modul" />

        <CollectionView
            x:Name="ModulesCollectionView"
            Grid.Row="3"
            SelectionMode="Single"
            SelectionChanged="OnModuleSelectionChanged">

            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    Orientation="Vertical"
                    Span="2" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        Margin="8"
                        Padding="20"
                        StrokeThickness="1">

                        <VerticalStackLayout Spacing="8">

                            <Label
                                FontAttributes="Bold"
                                FontSize="22"
                                HorizontalTextAlignment="Center"
                                Text="{Binding DisplayName}" />

                            <Label
                                FontSize="14"
                                HorizontalTextAlignment="Center"
                                Text="{Binding Manufacturer}" />

                            <Label
                                FontSize="12"
                                HorizontalTextAlignment="Center"
                                Opacity="0.7"
                                Text="{Binding Category}" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>